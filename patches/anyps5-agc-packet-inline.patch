+// Up to N elements on the stack, more on the heap: register lists are short, and every vector here
+// was a guest malloc/free pair through the box64 bridge per packet.
+template<typename T, std::size_t N>
+class SmallBuffer {
+public:
+    void push_back(const T& value) {
+        if (size_ < N) { inline_[size_++] = value; return; }
+        if (heap_.empty()) heap_.assign(inline_, inline_ + size_);
+        heap_.push_back(value);
+        ++size_;
     }
+    void assign(const T* first, const T* last) {
+        clear();
+        for (; first != last; ++first) push_back(*first);
+    }
+    void clear() { size_ = 0; heap_.clear(); }
+    std::size_t size() const { return size_; }
+    const T* data() const { return heap_.empty() ? inline_ : heap_.data(); }
+    const T& operator[](std::size_t index) const { return data()[index]; }
+    const T& back() const { return data()[size_ - 1]; }
+    const T* begin() const { return data(); }
+    const T* end() const { return data() + size_; }
+
+private:
+    T inline_[N];
+    std::vector<T> heap_;
+    std::size_t size_ = 0;
+};
+
