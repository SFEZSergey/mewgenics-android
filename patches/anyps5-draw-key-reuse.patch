+// Whether a draw key was seen recently: a key enters the draw cache only at its second sighting.
+// Titles that stream per-draw constants put a ring-buffer address in the user words (Mewgenics:
+// one more 256-byte slot per sprite), so most keys are never seen again, and inserting each one
+// (variant copies, an entry, an eviction freeing another) was a seventh of the queue worker.
+// One table per queue worker thread; a slot holds the last key that hashed to it.
+// APS5_NO_DRAW_KEY_FILTER=1 inserts at the first sighting again.
+bool seenDrawKey(std::uint64_t key) {
+    static const bool filter = std::getenv("APS5_NO_DRAW_KEY_FILTER") == nullptr;
+    if (!filter) return true;
+    static thread_local std::vector<std::uint64_t> seen(std::size_t{1} << 16u);
+    auto& slot = seen[(key * 0x9e3779b97f4a7c15ull) >> 48u];
+    if (slot == key) return true;
+    slot = key;
+    return false;
+}
