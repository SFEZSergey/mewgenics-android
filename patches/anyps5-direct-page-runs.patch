+// The allocated physical memory, as runs of one backing (an allocation, or what a partial release
+// left of it): a page answers with its backing and offset as a per-page map did, but an allocation
+// or a release of hundreds of MiB is one entry instead of tens of thousands of 16 KiB nodes (the
+// tree walks were the second hottest x86 code of the Mewgenics game thread).
+class PhysicalPages {
+public:
+    std::optional<PhysicalPage> Find(std::uint64_t page) const {
+        auto it = runs.upper_bound(page);
+        if (it == runs.begin()) return std::nullopt;
+        --it;
+        if (page >= it->second.end) return std::nullopt;
+        return PhysicalPage{it->second.backing, it->second.offset + (page - it->first)};
+    }
+    bool Contains(std::uint64_t page) const { return Find(page).has_value(); }
+    // The first page of [first, first + len) that no run holds, or nullopt if all are held.
+    std::optional<std::uint64_t> FirstMissing(std::uint64_t first, std::size_t len) const {
+        std::uint64_t cursor = first;
+        const std::uint64_t last = first + len;
+        while (cursor < last) {
+            auto it = runs.upper_bound(cursor);
+            if (it == runs.begin()) return cursor;
+            --it;
+            if (cursor >= it->second.end) return cursor;
+            cursor = it->second.end;
+        }
+        return std::nullopt;
+    }
+    bool Overlaps(std::uint64_t first, std::size_t len) const {
+        auto it = runs.upper_bound(first);
+        if (it != runs.begin() && std::prev(it)->second.end > first) return true;
+        return it != runs.end() && it->first < first + len;
+    }
+    void Insert(std::uint64_t first, std::size_t len, const std::shared_ptr<PhysicalBacking>& backing) {
+        runs.emplace(first, Run{first + len, backing, 0});
+    }
+    void Erase(std::uint64_t first, std::uint64_t last) {
+        auto it = runs.upper_bound(first);
+        if (it != runs.begin()) {
+            auto previous = std::prev(it);
+            if (previous->second.end > first) {
+                const Run run = previous->second;
+                const auto start = previous->first;
+                if (run.end > last) runs.emplace(last, Run{run.end, run.backing, run.offset + (last - start)});
+                if (start < first) previous->second.end = first;
+                else runs.erase(previous);
+            }
+        }
+        it = runs.lower_bound(first);
+        while (it != runs.end() && it->first < last) {
+            const Run run = it->second;
+            const auto start = it->first;
+            it = runs.erase(it);
+            if (run.end > last) {
+                runs.emplace(last, Run{run.end, run.backing, run.offset + (last - start)});
+                break;
+            }
+        }
+    }
+
+private:
+    struct Run {
+        std::uint64_t end;
+        std::shared_ptr<PhysicalBacking> backing;
+        std::uint64_t offset;  // of the run's first page in its backing
+    };
+    std::map<std::uint64_t, Run> runs;
+};
