+void PublishDirect(std::int32_t targetX, std::int32_t targetY, std::uint32_t button, bool pressed, std::uintptr_t delta) {
+    std::lock_guard lock(mouseMutex);
+    connected = true;
+
+    targetX = std::clamp(targetX, 0, 1920);
+    targetY = std::clamp(targetY, 0, 1080);
+
+    if (delta == 0) {
+        typedef uintptr_t (*delta_fn)(void);
+        static delta_fn get_delta = nullptr;
+        if (!get_delta) {
+            void* box = dlopen("libbox64.so", RTLD_NOW | RTLD_NOLOAD);
+            if (box) get_delta = (delta_fn)dlsym(box, "Aps5GetAppElfDelta");
+            if (!get_delta) get_delta = (delta_fn)dlsym(RTLD_DEFAULT, "Aps5GetAppElfDelta");
+        }
+        if (get_delta) delta = get_delta();
+    }
+
+    if (delta != 0) {
+        int32_t curX = *(const int32_t*)(delta + 0x1ab61c0);
+        int32_t curY = *(const int32_t*)(delta + 0x1ab61c4);
+        if (curX < 0 || curX > 1920 || curY < 0 || curY > 1080) {
+            curX = 960;
+            curY = 540;
+        }
+        const int32_t deltaX = targetX - curX;
+        const int32_t deltaY = targetY - curY;
+        absoluteX = 960.0 + deltaX;
+        absoluteY = 540.0 + deltaY;
+    } else {
+        absoluteX = targetX;
+        absoluteY = targetY;
+    }
+
+    if (button != 0) {
+        if (pressed) {
+            buttons |= button;
+            pressedSinceRead |= button;
+        } else {
+            buttons &= ~button;
+        }
+    }
+}
