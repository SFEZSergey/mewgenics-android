+// The lease the import paths need around [begin, end): the registry ranges overlapping the window
+// grown to the allocations of the ranges in it and to the imports overlapping it, so that every run
+// they build (a run stays within one allocation, see continuesRun) and every import they retire
+// sees the same ranges as in a lease of the whole registry. Leasing the whole registry copied and
+// pinned all ~1600 ranges through the box64 bridge for every GPU mapping (half of the game thread
+// in the rainy Mewgenics hub). APS5_FULL_LEASE=1, runs spanning allocations or a non-Android build
+// lease everything as before.
+bool windowLeases() {
+#ifdef __ANDROID__
+    static const bool enabled = std::getenv("APS5_FULL_LEASE") == nullptr && std::getenv("APS5_IMPORT_SPAN_ALLOCATIONS") == nullptr;
+    return enabled;
+#else
+    return false;
+#endif
+}
+
+void growToImports(const HostImports& state, std::uint64_t& begin, std::uint64_t& end) {
+    for (bool grown = true; grown;) {
+        grown = false;
+        auto it = state.imports.lower_bound(begin);
+        if (it != state.imports.begin()) --it;
+        for (; it != state.imports.end() && it->second.base < end; ++it) {
+            const auto importEnd = it->second.base + it->second.bytes;
+            if (importEnd <= begin) continue;
+            if (it->second.base < begin) begin = it->second.base, grown = true;
+            if (importEnd > end) end = importEnd, grown = true;
+        }
+    }
+}
+
+GuestAllocations::Lease leaseWindow(const HostImports& state, std::uint64_t begin, std::uint64_t end) {
+    if (!windowLeases()) return GuestAllocations::GuestAllocationsAcquire_nid_postfix();
+    if (begin >= end) return {};
+    growToImports(state, begin, end);
+    // The allocations of the ranges at the window's edges, then the imports over them, until stable.
+    for (int round = 0; round < 8; ++round) {
+        auto lease = GuestAllocations::GuestAllocationsAcquireWindow_nid_postfix(begin, end);
+        auto grownBegin = begin;
+        auto grownEnd = end;
+        for (const auto& range : lease) {
+            if (range->allocationBytes == 0) continue;
+            grownBegin = std::min<std::uint64_t>(grownBegin, range->allocationAddress);
+            grownEnd = std::max<std::uint64_t>(grownEnd, range->allocationAddress + range->allocationBytes);
+        }
+        growToImports(state, grownBegin, grownEnd);
+        if (grownBegin == begin && grownEnd == end) return lease;
+        begin = grownBegin;
+        end = grownEnd;
+    }
+    return GuestAllocations::GuestAllocationsAcquire_nid_postfix();
+}
