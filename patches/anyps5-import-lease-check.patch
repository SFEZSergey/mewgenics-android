+#if !defined(_WIN32)
+// Read-write ranges of the lease cover [base, base + bytes) without a gap.
+bool leaseCoversReadWrite(const GuestAllocations::Lease& lease, std::uint64_t base, std::uint64_t bytes) {
+    std::vector<std::pair<std::uint64_t, std::uint64_t>> spans;
+    spans.reserve(lease.size());
+    for (const auto& range : lease) {
+        if (range == nullptr || !range->readable || !range->writable) continue;
+        spans.emplace_back(range->address, range->address + range->bytes);
+    }
+    std::sort(spans.begin(), spans.end());
+    auto covered = base;
+    const auto end = base + bytes;
+    for (const auto& [first, last] : spans) {
+        if (first > covered) break;
+        covered = std::max(covered, last);
+        if (covered >= end) return true;
+    }
+    return covered >= end;
+}
+#endif
