 std::map<std::uintptr_t, DirectMapping> g_directMappings;
+// The same mappings by physical start (phys, base), one set per length class (bit width of the
+// length): releases and aliasing checks look mappings up by physical range, and walking every
+// mapping per release grew with the session. A mapping of class k is shorter than 2^k, so a query
+// scans each class only from 2^k below its range: one long mapping no longer widens the scan of all
+// the short ones. Every change of g_directMappings goes through PutMapping/TakeMapping.
+std::array<std::set<std::pair<std::uint64_t, std::uintptr_t>>, 65> g_mappingsByPhys;
+
+unsigned LengthClass(std::uint64_t bytes) {
+    return static_cast<unsigned>(std::bit_width(bytes));
+}
+
+std::map<std::uintptr_t, DirectMapping>::iterator PutMapping(std::uintptr_t base, DirectMapping mapping) {
+    const auto [it, inserted] = g_directMappings.emplace(base, std::move(mapping));
+    if (inserted) g_mappingsByPhys[LengthClass(it->second.end - base)].emplace(it->second.phys, base);
+    return it;
+}
+
+std::map<std::uintptr_t, DirectMapping>::iterator TakeMapping(std::map<std::uintptr_t, DirectMapping>::iterator it) {
+    g_mappingsByPhys[LengthClass(it->second.end - it->first)].erase({it->second.phys, it->first});
+    return g_directMappings.erase(it);
+}
+
+// Bases of the mappings whose physical range overlaps [first, last), in no particular order.
+std::vector<std::uintptr_t> MappingsOverlappingPhys(std::uint64_t first, std::uint64_t last) {
+    std::vector<std::uintptr_t> bases;
+    if (first >= last) return bases;
+    for (unsigned k = 0; k < g_mappingsByPhys.size(); ++k) {
+        const auto& set = g_mappingsByPhys[k];
+        if (set.empty()) continue;
+        const std::uint64_t reach = k >= 64 ? ~std::uint64_t{0} : (std::uint64_t{1} << k);
+        const auto from = first > reach ? first - reach : 0;
+        for (auto it = set.lower_bound({from, 0}); it != set.end() && it->first < last; ++it) {
+            const auto& mapping = g_directMappings.at(it->second);
+            if (mapping.phys + (mapping.end - it->second) > first) bases.push_back(it->second);
+        }
+    }
+    return bases;
+}
 
