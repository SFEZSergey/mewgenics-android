+// Released physical memory goes back to the host: the backing file's pages of a released range
+// are punched out (they read as zeros afterwards, so a later allocation needs no clearing), else
+// every page the title ever touched stayed allocated in the memfd and was swapped out instead
+// (Mewgenics: ~5 GiB of direct memory in swap). Off unless APS5_PUNCH_RELEASED=1: GPU imports of
+// the backing (dma-buf over the memfd, pinned host pointers) keep the old pages, so after a punch
+// and a reuse the GPU read stale texels (broken floor and cursor, 2026-10-23).
+bool PunchReleased() {
+    static const bool enabled = std::getenv("APS5_PUNCH_RELEASED") != nullptr;
+    return enabled;
+}
+
+bool PunchPhysical(std::uint64_t start, std::size_t bytes) {
+    return bytes != 0 && ::fallocate(PhysicalFile(), FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE, static_cast<off_t>(start), static_cast<off_t>(bytes)) == 0;
+}
+
+// [direct-memory] every 10 s while the title allocates or releases: what it holds now.
+std::uint64_t g_directAllocated = 0, g_directReleased = 0, g_directLive = 0, g_directPunched = 0;
+std::uint64_t g_directReported = 0;
+
+void ReportDirectMemory() {
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    const auto seconds = static_cast<std::uint64_t>(now.tv_sec);
+    if (g_directReported == 0) g_directReported = seconds;
+    if (seconds - g_directReported < 10) return;
+    g_directReported = seconds;
+    std::fprintf(stderr, "[direct-memory] 10 s: %llu MiB allocated, %llu MiB released (%llu MiB returned to the host); %llu MiB live\n", static_cast<unsigned long long>(g_directAllocated >> 20), static_cast<unsigned long long>(g_directReleased >> 20), static_cast<unsigned long long>(g_directPunched >> 20), static_cast<unsigned long long>(g_directLive >> 20));
+    g_directAllocated = g_directReleased = g_directPunched = 0;
+}
+
