+bool FillDepthSurfaces(const Context& context, std::uint64_t address, std::size_t bytes, std::span<const std::uint32_t, 4> pattern) {
+    static const bool enabled = std::getenv("APS5_NO_DEPTH_FILL_CLEAR") == nullptr;
+    if (!enabled || bytes == 0 || !std::all_of(pattern.begin(), pattern.end(), [&](std::uint32_t word) { return word == pattern[0]; })) return false;
+    const auto covers = [&](std::uint64_t plane, std::uint64_t planeBytes) { return plane != 0 && address <= plane && address + bytes >= plane + planeBytes; };
+    std::lock_guard lock(surfacesMutex());
+    bool filled = false;
+    for (const auto& surface : surfaces()) {
+        if (surface->context.device != context.device) continue;
+        const auto& target = surface->target;
+        const bool d16 = target.format == VK_FORMAT_D16_UNORM || target.format == VK_FORMAT_D16_UNORM_S8_UINT;
+        if (covers(target.address, DepthSliceBytes(target.extent, d16 ? 2u : 4u)) && (!d16 || (pattern[0] & 0xffffu) == pattern[0] >> 16u)) {
+            surface->ClearAspect(VK_IMAGE_ASPECT_DEPTH_BIT, d16 ? static_cast<float>(pattern[0] & 0xffffu) / 65535.0f : std::bit_cast<float>(pattern[0]), 0);
+            filled = true;
+        }
+        if (covers(target.stencilAddress, DepthSliceBytes(target.extent, 1u)) && pattern[0] == (pattern[0] & 0xffu) * 0x01010101u) {
+            surface->ClearAspect(VK_IMAGE_ASPECT_STENCIL_BIT, 0.0f, pattern[0] & 0xffu);
+            filled = true;
+        }
+    }
+    return filled;
+}
