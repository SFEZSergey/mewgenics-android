+// Whether the registry changes logged since the last take (GuestMemory::TakeRegistryChanges) miss
+// every import and every failed import, so the imports stay reconciled without a registry walk.
+// The game's heap allocations and frees move the generation all the time without touching memory
+// the GPU imported; the walk (a lease of the whole registry) cost a fifth of the draw recorder.
+bool importsUntouched(const HostImports& state) {
+    static thread_local std::vector<std::pair<std::uintptr_t, std::size_t>>* changesSlot = nullptr;
+    auto& changes = ShaderRecompiler::ThreadOwned(changesSlot);
+    if (!GuestMemory::TakeRegistryChanges(changes)) return false;
+    for (const auto& [address, bytes] : changes) {
+        const std::uint64_t end = address + bytes;
+        auto it = state.imports.lower_bound(address > state.largestImport ? address - state.largestImport : 0);
+        for (; it != state.imports.end() && it->first < end; ++it) {
+            if (it->second.base < end && it->second.base + it->second.bytes > address) return false;
+        }
+        if (const auto failed = state.failed.lower_bound(address); failed != state.failed.end() && *failed < end) return false;
+    }
+    return true;
+}
