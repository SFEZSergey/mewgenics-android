+// The registry changes the host imports have not seen yet (TakeRegistryChanges). `primed` turns on
+// with the first take: changes before the invalidator was registered were never logged, so that
+// take reports the log incomplete.
+struct RegistryChangeLog {
+    std::mutex mutex;
+    std::vector<std::pair<std::uintptr_t, std::size_t>> ranges;
+    bool overflow = false;
+    bool primed = false;
+};
+RegistryChangeLog& RegistryChanges() {
+    static RegistryChangeLog log;
+    return log;
+}
+std::atomic<bool> registryChangesPending{false};
+std::atomic<bool> pageCachesOn{false};
+
+// The libc invalidator: forgets the cached page states and logs the range for the host imports.
+void RegistryChanged(std::uintptr_t address, std::size_t bytes) {
+    if (pageCachesOn.load(std::memory_order_acquire)) ForgetPages(address, bytes);
+    auto& log = RegistryChanges();
+    std::lock_guard lock(log.mutex);
+    if (log.ranges.size() < 4096) log.ranges.emplace_back(address, bytes);
+    else log.overflow = true;
+    registryChangesPending.store(true, std::memory_order_release);
+}
