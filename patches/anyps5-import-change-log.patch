+
+bool TakeRegistryChanges(std::vector<std::pair<std::uintptr_t, std::size_t>>& into) {
+    Pages().initialize();
+    into.clear();
+    auto& log = RegistryChanges();
+    std::lock_guard lock(log.mutex);
+    into.swap(log.ranges);
+    const bool complete = log.primed && !log.overflow;
+    log.primed = true;
+    log.overflow = false;
+    registryChangesPending.store(false, std::memory_order_release);
+    return complete;
+}
