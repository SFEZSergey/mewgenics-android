+#ifdef ANDROID
+// AnyPS5: signal-mask syscalls by call site ("[sigmask]" line every 10 s in the log), to find the one
+// that keeps the game thread in rt_sigprocmask.
+static const char* const sigmask_site_names[] = {"guest-sigprocmask", "guest-pthread_sigmask", "sigsetjmp-save", "longjmp-restore", "getcontext", "setcontext", "swapcontext", "sigaltstack", "dynablock-alt", "dynablock-get", "signal-return"};
+#define SIGMASK_SITES (int)(sizeof(sigmask_site_names) / sizeof(sigmask_site_names[0]))
+static uint64_t sigmask_counts[SIGMASK_SITES];
+static uint64_t sigmask_report_at;
+void box64_sigmask_count(int site)
+{
+    if(site < 0 || site >= SIGMASK_SITES) return;
+    __atomic_fetch_add(&sigmask_counts[site], 1, __ATOMIC_RELAXED);
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC_COARSE, &now);
+    const uint64_t seconds = (uint64_t)now.tv_sec;
+    uint64_t due = __atomic_load_n(&sigmask_report_at, __ATOMIC_RELAXED);
+    if(due == 0) { __atomic_compare_exchange_n(&sigmask_report_at, &due, seconds + 10, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED); return; }
+    if(seconds < due || !__atomic_compare_exchange_n(&sigmask_report_at, &due, seconds + 10, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) return;
+    char line[512]; int used = snprintf(line, sizeof(line), "[sigmask] 10 s:");
+    for(int i = 0; i < SIGMASK_SITES && used < (int)sizeof(line); ++i) {
+        const uint64_t count = __atomic_exchange_n(&sigmask_counts[i], 0, __ATOMIC_RELAXED);
+        if(count) used += snprintf(line + used, sizeof(line) - used, " %s %llu", sigmask_site_names[i], (unsigned long long)count);
+    }
+    printf_log(LOG_NONE, "%s\n", line);
+}
+#define SIGMASK_COUNT(site) box64_sigmask_count(site)
+#else
+#define SIGMASK_COUNT(site) do {} while(0)
+#endif
