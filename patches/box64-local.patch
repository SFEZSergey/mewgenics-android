+
+// The x86 instruction the native address belongs to (not the block start): the host sampler groups
+// samples by guest function, and one block can span a whole function. NULL outside translated code.
+uintptr_t getX64Address(dynablock_t* db, uintptr_t native_addr);
+EXPORT void* box64_native_to_x64_exact(void* p)
+{
+    if(!rbt_dynmem)
+        return NULL;
+    dynablock_t* db = FindDynablockFromNativeAddress(p);
+    if(!db || !db->done || db->gone)
+        return NULL;
+    uintptr_t x64 = getX64Address(db, (uintptr_t)p);
+    return (void*)(x64 ? x64 : (uintptr_t)db->x64_addr);
