+            if(c > best) { best = c; bm = m; bp = p; bo = o; bl = l; }
+        }
+        if(!best) break;
+        __atomic_store_n(&aps5_avx_counts[bm][bp][bo][bl], 0, __ATOMIC_RELAXED);
+        static const char* maps[4] = {"?", "0F", "0F38", "0F3A"};
+        static const char* prefixes[4] = {"--", "66", "F3", "F2"};
+        used += snprintf(line + used, sizeof(line) - used, " %s.%s.%02X.%d=%u", prefixes[bp], maps[bm], bo, 128 << bl, best);
+        if(used >= (int)sizeof(line) - 40) break;
+    }
+    for(int m = 0; m < 4; ++m) for(int p = 0; p < 4; ++p) for(int o = 0; o < 256; ++o) for(int l = 0; l < 2; ++l) __atomic_store_n(&aps5_avx_counts[m][p][o][l], 0, __ATOMIC_RELAXED);
+    fprintf(stderr, "%s\n", line);
