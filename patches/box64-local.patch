+    if(sec - last < 10 || !__atomic_compare_exchange_n(&aps5_avx_reported, &last, sec, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) return;
+    char line[1024]; int used = snprintf(line, sizeof(line), "[avx-interp] 10 s:");
