+static void aps5_avx_count(vex_t vex, uint8_t opcode)
+{
+    if(vex.m > 3 || vex.p > 3) return;
+    __atomic_fetch_add(&aps5_avx_counts[vex.m][vex.p][opcode][vex.l & 1], 1, __ATOMIC_RELAXED);
