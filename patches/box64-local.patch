+#ifdef ANDROID
+// AnyPS5 write watch (aps5native): host protections of `pages` pages of `page` bytes from box64's own
+// map, instead of a parse of /proc/self/maps (huge under box64) per newly watched range. out[i] is
+// PROT_READ|PROT_WRITE|PROT_EXEC, or 0 when box64 does not know the page or guards it for the dynarec
+// (its host protection then differs from the recorded one): the caller reads those from maps.
+EXPORT void box64_aps5_page_protections(uintptr_t begin, size_t pages, size_t page, uint8_t* out)
+{
+    const uintptr_t end = begin + pages * page;
+    LOCK_PROT_READ();
+    for (uintptr_t addr = begin; addr < end;) {
+        uint32_t prot = 0;
+        uintptr_t bend = 0;
+        const int found = rb_get_end(memprot, addr, &prot, &bend);
+        if (bend <= addr || bend > end) bend = end;
+        const uint8_t value = (found && !(prot & PROT_CUSTOM)) ? (uint8_t)(prot & (PROT_READ | PROT_WRITE | PROT_EXEC)) : 0;
+        for (; addr < bend; addr += page) out[(addr - begin) / page] = value;
+    }
+    UNLOCK_PROT_READ();
+}
+#endif
