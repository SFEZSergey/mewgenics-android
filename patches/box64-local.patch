+// Game libc results are the byte difference of the first mismatch (movzb/sub), not just its sign:
+// these return exactly that. bionic's memcmp only finds equal ranges fast.
+static int Aps5MemCmp(const void* a, const void* b, size_t size)
+{
+    const uint8_t* x = a;
+    const uint8_t* y = b;
+    size_t i = 0;
+    for (; i + 8 <= size; i += 8) {
+        uint64_t u, v;
+        memcpy(&u, x + i, 8);
+        memcpy(&v, y + i, 8);
+        if (u != v) break;
+    }
+    for (; i < size; ++i)
+        if (x[i] != y[i]) return (int)x[i] - (int)y[i];
+    return 0;
+}
+
+// bcmp: 0 or 1 (setne).
